{
	"name": "wp-compat-scanner/wp-compat-scanner-plugin",
	"description": "WordPress plugin wrapper for wp-since compatibility checker",
	"type": "wordpress-plugin",
	"license": "MIT",
	"require": {
		"php": ">=7.4",
		"eduardovillao/wp-since": "^1.4"
	},
	"require-dev": {
		"wp-cli/wp-cli": "^2.0"
	},
	"autoload": {
		"psr-4": {
			"WP_Compat_Scanner\\": "includes/"
		}
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true
		}
	}
}
